---
// src/pages/tags/[tag].astro
import type { GetStaticPaths } from "astro";
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/post/PostList.astro";
import { getAllTags, getPostsByTag } from "@/services/content";
import type { Post } from "@/domain/types";

export const getStaticPaths: GetStaticPaths = async () => {
  const tags = await getAllTags();

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tagName: tag.name },
  }));
};

interface Props {
  tagName: string;
}

const { tagName } = Astro.props;
const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
---

<ListLayout title={`标签: ${tagName}`}>
  <div class="mb-8">
    <p class="mt-2 text-tb-muted">共找到 {posts.length} 篇文章</p>
    <a
      href="/tags"
      class="mt-4 inline-block text-sm text-tb-primary hover:underline"
      >← 返回所有标签</a
    >
  </div>

  <PostList posts={posts} showCover={true} />
</ListLayout>
