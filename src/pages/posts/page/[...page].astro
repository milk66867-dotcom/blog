---
import type { GetStaticPaths } from "astro";
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/post/PostList.astro";
import Pagination from "@/components/ui/Pagination.astro";
import { getAllPosts } from "@/services/content";
import { siteConfig } from "@/config/site.config";
import type { Post } from "@/domain/types";

export const getStaticPaths: GetStaticPaths = async () => {
  const allPosts = await getAllPosts();
  const pageSize = siteConfig.pagination.pageSize;
  const totalPages = Math.ceil(allPosts.length / pageSize);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * pageSize, page * pageSize),
        currentPage: page,
        totalPages,
      },
    };
  });
};

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<ListLayout title={`文章 - 第 ${currentPage} 页`}>
  <PostList posts={posts} showCover={true} />
  <Pagination current={currentPage} total={totalPages} basePath="/posts" />
</ListLayout>
