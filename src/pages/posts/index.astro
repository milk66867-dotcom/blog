---
import ListLayout from "@/layouts/ListLayout.astro";
import PostList from "@/components/post/PostList.astro";
import Pagination from "@/components/ui/Pagination.astro";
import { getAllPosts } from "@/services/content";
import { siteConfig } from "@/config/site.config";

const allPosts = await getAllPosts();
const pageSize = siteConfig.pagination.pageSize;
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.max(1, Math.ceil(allPosts.length / pageSize));
---

<ListLayout title="文章">
  <PostList posts={posts} showCover={true} />
  {
    totalPages > 1 && (
      <Pagination current={1} total={totalPages} basePath="/posts" />
    )
  }
</ListLayout>
