---
// src/layouts/PostLayout.astro
import BaseLayout from "./BaseLayout.astro";
import type { Post } from "@/domain/types";
import PostMeta from "@/components/post/PostMeta.astro";
import PostToc from "@/components/post/PostToc.astro";
import PostNav from "@/components/post/PostNav.astro";
import PostRelated from "@/components/post/PostRelated.astro";
import MarkdownRenderer from "@/components/markdown/MarkdownRenderer.astro";
import CodeBlock from "@/components/markdown/CodeBlock";
import ImageLightbox from "@/components/markdown/ImageLightbox";
import MarkdownStyleSwitcher from "@/components/post/MarkdownStyleSwitcher";

// 1. 引入生成 JSON-LD 的服务和站点配置
import { buildArticleJsonLd } from "@/services/seo";
import { siteConfig } from "@/config/site.config";

interface Props {
  post: Post;
  prev?: Post | null;
  next?: Post | null;
  related?: Post[];
}

const { post, prev = null, next = null, related = [] } = Astro.props;

const style = post.frontmatter.style ?? "github";
const showToc = post.frontmatter.toc !== false && post.toc.length > 0;
const showComments = post.frontmatter.comments !== false;

// 2. 生成合并后的 SEO 对象
const articleJsonLd = buildArticleJsonLd(post, siteConfig);
const finalSeo = {
  ...post.seo,
  jsonLd: articleJsonLd,
};
---

<!-- 3. 直接传入完整的 seo 对象，移除零散的 title/description 等属性 -->
<BaseLayout title={post.frontmatter.title} seo={finalSeo}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
      {
        showToc && (
          <>
            <aside class="hidden lg:block">
              <div class="sticky top-8">
                <PostToc toc={post.toc} />
              </div>
            </aside>

            <details class="lg:hidden rounded border border-tb-border p-3">
              <summary class="cursor-pointer text-sm font-medium">目录</summary>
              <div class="mt-2">
                <PostToc toc={post.toc} />
              </div>
            </details>
          </>
        )
      }

      <article class="min-w-0" data-md-style={style} id="post-content">
        <header class="mb-8">
          <h1 class="text-3xl font-bold leading-tight">
            {post.frontmatter.title}
          </h1>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
            <PostMeta post={post} />
            <MarkdownStyleSwitcher client:load initialStyle={style} />
          </div>
        </header>

        <MarkdownRenderer
          content={post.html}
          style={style}
          toc={post.frontmatter.toc}
          math={post.frontmatter.math}
          mermaid={post.frontmatter.mermaid}
          codeCopy={true}
          imageLightbox={true}
          headings={post.headings}
        />

        {
          showComments && (
            <section class="mt-12 rounded border border-dashed border-tb-border p-6 text-center text-sm text-tb-muted">
              评论区将在阶段 10 接入 Giscus。
            </section>
          )
        }

        <PostNav prev={prev} next={next} />
        <PostRelated posts={related} />
      </article>
    </div>
  </div>

  <CodeBlock client:visible />
  <ImageLightbox client:visible />
</BaseLayout>
