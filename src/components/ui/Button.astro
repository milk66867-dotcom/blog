---
// src/components/ui/Button.astro
interface Props {
    variant?: "primary" | "secondary" | "ghost";
    size?: "sm" | "md" | "lg";
    href?: string;
    disabled?: boolean;
    type?: "button" | "submit";
}

const {
    variant = "primary",
    size = "md",
    href,
    disabled = false,
    type = "button",
} = Astro.props;

const base =
    "inline-flex items-center justify-center rounded-md font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tb-primary disabled:opacity-50 disabled:pointer-events-none";

const variants = {
    primary: "bg-tb-primary text-white hover:opacity-90",
    secondary: "border border-tb-border text-tb-fg hover:bg-tb-border/40",
    ghost: "text-tb-fg hover:bg-tb-border/40",
};

const sizes = {
    sm: "text-sm px-3 py-1.5",
    md: "text-sm px-4 py-2",
    lg: "text-base px-5 py-2.5",
};

const cls = `${base} ${variants[variant]} ${sizes[size]}`;
---

{
    href ? (
        <a href={href} class={cls}>
            <slot />
        </a>
    ) : (
        <button type={type} disabled={disabled} class={cls}>
            <slot />
        </button>
    )
}
