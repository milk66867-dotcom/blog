---
// src/components/post/PostCard.astro
import type { Post } from "@/domain/types";
import Card from "@/components/ui/Card.astro";
import PostMeta from "./PostMeta.astro";

interface Props {
    post: Post;
    showCover?: boolean;
    showSummary?: boolean;
}

const { post, showCover = false, showSummary = true } = Astro.props;
---

<Card hover>
    <article>
        {
            showCover && post.frontmatter.cover && (
                <a
                    href={post.url}
                    class="mb-3 block overflow-hidden rounded-md"
                >
                    <img
                        src={post.frontmatter.cover}
                        alt={post.frontmatter.title}
                        loading="lazy"
                        decoding="async"
                        class="h-40 w-full object-cover transition-transform hover:scale-105"
                    />
                </a>
            )
        }

        <h2 class="text-lg font-semibold leading-snug">
            <a href={post.url} class="hover:text-tb-primary"
                >{post.frontmatter.title}</a
            >
        </h2>

        <!-- PostMeta 内部已经包含了日期、分类和标签 -->
        <div class="mt-2">
            <PostMeta post={post} />
        </div>

        {
            showSummary && (
                <p class="mt-3 line-clamp-2 text-sm text-tb-muted">
                    {post.excerpt}
                </p>
            )
        }
    </article>
</Card>
