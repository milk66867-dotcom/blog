---
// src/components/post/PostNav.astro
import type { Post } from "@/domain/types";

interface Props {
    prev?: Post | null;
    next?: Post | null;
}

const { prev, next } = Astro.props;
---

{
    (prev || next) && (
        <nav class="mt-12 grid gap-4 border-t border-tb-border pt-6 sm:grid-cols-2">
            <div>
                {prev && (
                    <a href={prev.url} class="group block">
                        <span class="text-xs text-tb-muted">← 上一篇</span>
                        <p class="mt-1 text-sm font-medium group-hover:text-tb-primary">
                            {prev.frontmatter.title}
                        </p>
                    </a>
                )}
            </div>
            <div class="sm:text-right">
                {next && (
                    <a href={next.url} class="group block">
                        <span class="text-xs text-tb-muted">下一篇 →</span>
                        <p class="mt-1 text-sm font-medium group-hover:text-tb-primary">
                            {next.frontmatter.title}
                        </p>
                    </a>
                )}
            </div>
        </nav>
    )
}
